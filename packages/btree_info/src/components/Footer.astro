---
import IconsSocial from './IconsSocial.astro';

interface Props {
  lang?: string;
}

const { lang = 'en' } = Astro.props;
const now = new Date().getFullYear();
const tutorialsUrl = `https://www.btree.tv${lang === 'de' ? '/de' : ''}/`;
---

<footer class="h-20 w-full border-t">
  <div class="h-full w-full container mx-auto px-4 lg:px-8 flex items-center justify-between">
    <div class="flex items-end">
      <span class="mr-2 text-sm leading-none">
        © 2014-{now} - b.tree by Hannes Oberreiter
      </span>
    </div>
    <div class="flex items-center gap-4">
      <a
        href={tutorialsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm hover:text-green-500"
      >
        {lang === 'de' ? 'Tutorial-Videos' : 'Tutorial videos'}
      </a>
      <IconsSocial socialclass="flex" lang={lang} />
    </div>
  </div>
</footer>

<style scoped>
  footer {
    margin-top: auto;
    padding: 2rem 0;
    border-top: 3px solid var(--theme-divider);
  }
</style>
