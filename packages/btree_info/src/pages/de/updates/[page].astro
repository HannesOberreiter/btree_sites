---
import newsData from '../../../../public/news.json';
import StaticNews from '../../../components/StaticNews.astro';
import MainLayout from '../../../layouts/MainLayout.astro';

const pageSize = 10;

export function getStaticPaths() {
  const totalPages = Math.ceil(newsData.de.length / 10);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const page = Number(Astro.params.page ?? '1');
const frontmatter = {
  title: `Updates - Seite ${page}`,
  description: 'Änderungsprotokoll für b.tree Software',
  lang: 'de',
};
---

<MainLayout frontmatter={frontmatter} headings={[]}>
  <StaticNews lang="de" page={page} pageSize={pageSize} basePath="/de/updates/" />
</MainLayout>
