---
import newsData from '../../../public/news.json';
import StaticNews from '../../components/StaticNews.astro';
import MainLayout from '../../layouts/MainLayout.astro';

const pageSize = 10;

export function getStaticPaths() {
  const totalPages = Math.ceil(newsData.en.length / 10);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const page = Number(Astro.params.page ?? '1');
const frontmatter = {
  title: `Updates - Page ${page}`,
  description: 'Changelog for b.tree software',
  lang: 'en',
};
---

<MainLayout frontmatter={frontmatter} headings={[]}>
  <StaticNews lang="en" page={page} pageSize={pageSize} basePath="/updates/" />
</MainLayout>
