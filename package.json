{
  "name": "btree-sites",
  "private": true,
  "description": "btree static websites monorepo (btree_info, wizbee_info)",
  "scripts": {
    "build:btree-info": "pnpm --filter @btree/info build",
    "build:wizbee-info": "pnpm --filter wizbee_info build",
    "build:btree-tv": "pnpm --filter btree_tv build",
    "build": "pnpm -r build",
    "dev:btree-info": "pnpm --filter @btree/info dev",
    "dev:wizbee-info": "pnpm --filter wizbee_info dev",
    "dev:btree-tv": "pnpm --filter btree_tv dev",
    "generate-news": "node scripts/generate-news.mjs",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint . --fix && oxfmt --write .",
    "test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "^0.5.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
